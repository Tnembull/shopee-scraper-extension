{
  "manifest_version": 3,
  "name": "Shopee Scraper Extension",
  "version": "1.0.0",
  "description": "Scrape comments from Shopee product pages with real-time analytics and export to CSV",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://shopee.co.id/*",
    "https://*.shopee.co.id/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.co.id/*", "https://*.shopee.co.id/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
